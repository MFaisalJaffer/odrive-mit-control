<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mit_robot">

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>

  <!-- Joint 0 -->
  <joint name="joint0" type="revolute">
    <parent link="base_link"/>
    <child link="link0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1000" upper="1000" effort="100" velocity="100"/>
  </joint>

  <link name="link0">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.05"/>
      </geometry>
    </visual>
  </link>

  <!-- Control -->
  <ros2_control name="ODriveMIT" type="system">
    <hardware>
      <plugin>odrive_ros2_control/ODriveHardwareInterface</plugin>
      <param name="can">can0</param>
    </hardware>
    
    <joint name="joint0">
      <param name="node_id">0</param>
      
      <!-- State Interfaces -->
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      
      <!-- Command Interfaces for MIT Control -->
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="kp"/>
      <command_interface name="kd"/>
    </joint>
  </ros2_control>

</robot>

